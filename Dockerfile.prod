# ---- Build: compila los estáticos con Vite ----
FROM node:20-slim AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# VITE_API_URL se hornea en el bundle en build time (Vite no lee env vars en
# runtime) — hay que pasarla como build arg, no alcanza con env_file/environment.
ARG VITE_API_URL="http://vmb-dev.190.61.105.133.nip.io/api"
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ---- Runtime: sirve dist/ como estáticos con Nginx ----
FROM nginx:1.27-alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
